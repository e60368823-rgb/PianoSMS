<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#25262B" android:padding="4dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.05" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#34353B" android:padding="4dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DNC     AFTER TOUCH" android:textColor="#E7C94C" android:textStyle="bold" android:gravity="center" android:textSize="10sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/modeButton" style="@style/ConsoleButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:text="MODE"/>
                <Button android:id="@+id/menuButton" style="@style/ConsoleButton" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:text="MENU"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VOLUME" android:textColor="#E7C94C" android:textSize="10sp"/>
            <Button android:id="@+id/volumeButton" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="36dp" android:text="◉   VOLUME  +"/>
            <Button android:id="@+id/metronomeButton" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="32dp" android:text="METRONOME"/>
            <Button android:id="@+id/recordButton" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="32dp" android:text="RECORD / PLAY"/>
            <Button android:id="@+id/forwardButton" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="32dp" android:text="SMS / BALE"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.25" android:orientation="vertical" android:background="#15151B" android:padding="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#09090D" android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ERFAN  ♫" android:textColor="#F5F0FF" android:textSize="36sp" android:textStyle="bold" android:fontFamily="serif"/>
                <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="پیانو آماده" android:textColor="#E7C94C" android:textSize="12sp" android:gravity="center" android:layout_marginTop="8dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/testButton" style="@style/ConsoleButton" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:text="TEST BALE"/>
                <Button android:id="@+id/settingsButton" style="@style/ConsoleButton" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:text="⚙ SETTINGS"/>
                <Button android:id="@+id/powerButton" style="@style/ConsoleButton" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:text="⏻ POWER"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#34353B" android:padding="4dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SETTING" android:textColor="#E7C94C" android:textSize="10sp" android:gravity="center"/>
            <Button android:id="@+id/settingsButton2" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="32dp" android:text="SETTINGS"/>
            <Button android:id="@+id/powerButton2" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="32dp" android:text="START / STOP"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KEYBOARD SET" android:textColor="#E7C94C" android:textSize="10sp" android:gravity="center" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/styleButton" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="32dp" android:text="STYLE SELECT"/>
            <Button android:id="@+id/chordButton" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="32dp" android:text="CHORD / MIX"/>
            <Button android:id="@+id/mySettingButton" style="@style/ConsoleButton" android:layout_width="match_parent" android:layout_height="32dp" android:text="MY SETTING"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.9" android:orientation="horizontal" android:background="#BFC1C8" android:padding="2dp">
        <Button android:id="@+id/key1" style="@style/BigPianoKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="C"/>
        <Button android:id="@+id/key2" style="@style/BigPianoKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="D"/>
        <Button android:id="@+id/key3" style="@style/BigPianoKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="E"/>
        <Button android:id="@+id/key4" style="@style/BigPianoKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="F"/>
        <Button android:id="@+id/key5" style="@style/BigPianoKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="G"/>
        <Button android:id="@+id/key6" style="@style/BigPianoKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="A"/>
        <Button android:id="@+id/key7" style="@style/BigPianoKey" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="B"/>
    </LinearLayout>
</LinearLayout>
