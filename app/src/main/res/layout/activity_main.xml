<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#0D0D0D">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Piano SMS" android:textColor="#FFFFFF" android:textSize="28sp"
            android:textStyle="bold" android:layout_marginTop="22dp" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="در حال آماده‌سازی…"
            android:textColor="#D3B9FF" android:textSize="14sp" android:gravity="center"
            android:layout_marginTop="10dp" android:layout_marginBottom="18dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="توکن ربات بله" android:textColor="#FFFFFF" android:textSize="14sp" />
        <EditText android:id="@+id/tokenInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="توکن را اینجا وارد کن"
            android:inputType="textPassword" android:singleLine="true" android:textColor="#FFFFFF"
            android:textColorHint="#999999" android:backgroundTint="#C9A7FF" android:padding="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="شناسه چت بله" android:textColor="#FFFFFF" android:textSize="14sp"
            android:layout_marginTop="8dp" />
        <EditText android:id="@+id/chatIdInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="شناسه چت را وارد کن"
            android:inputType="text" android:singleLine="true" android:textColor="#FFFFFF"
            android:textColorHint="#999999" android:backgroundTint="#C9A7FF" android:padding="10dp" />
        <Button android:id="@+id/saveButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ذخیره تنظیمات روی گوشی"
            android:layout_marginTop="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="150dp"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="18dp">
            <Button android:id="@+id/key1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:backgroundTint="#F0F0F0" android:text="" />
            <Button android:id="@+id/key2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:backgroundTint="#F0F0F0" android:text="" />
            <Button android:id="@+id/key3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:backgroundTint="#F0F0F0" android:text="" />
            <Button android:id="@+id/key4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:backgroundTint="#F0F0F0" android:text="" />
            <Button android:id="@+id/key5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:backgroundTint="#F0F0F0" android:text="" />
            <Button android:id="@+id/key6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:backgroundTint="#F0F0F0" android:text="" />
            <Button android:id="@+id/key7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:backgroundTint="#F0F0F0" android:text="" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="کلیدها را لمس کن" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="8dp" />
        <Button android:id="@+id/testButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="تست ارسال به بله"
            android:layout_marginTop="14dp" android:paddingHorizontal="24dp" />
    </LinearLayout>
</ScrollView>
