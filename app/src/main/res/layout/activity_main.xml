<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:gravity="center"
                android:background="@drawable/bg_logo">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="♫" android:textColor="#FFFFFF" android:textSize="31sp" android:fontFamily="serif" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PIANO SMS" android:textColor="#FFFFFF" android:textSize="23sp"
                    android:textStyle="bold" android:letterSpacing="0.04" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="مدیریت پیامک، ساده و امن" android:textColor="#B9B0D0" android:textSize="13sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="نسخه ۲" android:textColor="#D8C7FF" android:textSize="11sp"
                android:background="@drawable/bg_version" android:paddingHorizontal="10dp" android:paddingVertical="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="17dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="وضعیت برنامه" android:textColor="#BFB2E4" android:textSize="12sp" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="در حال آماده‌سازی…"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:layout_marginTop="6dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#332A45" android:layout_marginTop="14dp" android:layout_marginBottom="12dp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoForwardSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ارسال خودکار پیامک‌های جدید"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#B99AFF"
                android:paddingVertical="3dp"
                android:layoutDirection="rtl" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="این گزینه پیش‌فرض خاموش است. فقط در صورت نیاز روشنش کن؛ پیامک‌ها ممکن است کد ورود یا اطلاعات خصوصی داشته باشند."
                android:textColor="#A69DBB" android:textSize="12sp" android:lineSpacingExtra="2dp"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اتصال به بله" android:textColor="#FFFFFF" android:textSize="18sp"
            android:textStyle="bold" android:layout_marginTop="25dp" android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="17dp"
            android:background="@drawable/bg_card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="توکن ربات" android:textColor="#D9C9FF" android:textSize="13sp" android:textStyle="bold" />
            <EditText android:id="@+id/tokenInput" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="7dp"
                android:hint="توکن را وارد کن" android:inputType="textPassword"
                android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#8F879F"
                android:background="@drawable/bg_input" android:paddingHorizontal="13dp"
                android:textSize="14sp" android:autofillHints="" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="شناسه چت مقصد" android:textColor="#D9C9FF" android:textSize="13sp"
                android:textStyle="bold" android:layout_marginTop="14dp" />
            <EditText android:id="@+id/chatIdInput" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="7dp"
                android:hint="شناسه چت بله" android:inputType="text"
                android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#8F879F"
                android:background="@drawable/bg_input" android:paddingHorizontal="13dp"
                android:textSize="14sp" />
            <Button android:id="@+id/saveButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="14dp"
                android:text="ذخیره تنظیمات" android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary" android:backgroundTint="@null"
                android:elevation="0dp" />
            <Button android:id="@+id/testButton" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="8dp"
                android:text="تست اتصال و ارسال پیام آزمایشی" android:textColor="#E6DBFF"
                android:background="@drawable/bg_button_outline" android:backgroundTint="@null"
                android:elevation="0dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="توکن را با کسی به اشتراک نگذار. تنظیمات فقط روی همین گوشی ذخیره می‌شود."
                android:textColor="#A69DBB" android:textSize="11sp" android:layout_marginTop="9dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="نوشتن پیام برای مخاطب" android:textColor="#FFFFFF" android:textSize="18sp"
            android:textStyle="bold" android:layout_marginTop="25dp" android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="17dp"
            android:background="@drawable/bg_card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="۱. مخاطب را انتخاب کن" android:textColor="#D9C9FF" android:textSize="13sp"
                android:textStyle="bold" />
            <Button android:id="@+id/pickContactButton" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="8dp"
                android:text="باز کردن دفترچه مخاطبین" android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_outline" android:backgroundTint="@null"
                android:elevation="0dp" />
            <TextView android:id="@+id/selectedContactText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="هنوز مخاطبی انتخاب نشده"
                android:textColor="#FFFFFF" android:textSize="14sp" android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_contact" android:padding="13dp" android:layout_marginTop="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="۲. متن پیام" android:textColor="#D9C9FF" android:textSize="13sp"
                android:textStyle="bold" android:layout_marginTop="15dp" />
            <EditText android:id="@+id/messageInput" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="112dp"
                android:hint="پیام خودت را اینجا بنویس…" android:inputType="textCapSentences|textMultiLine"
                android:gravity="top|start" android:textColor="#FFFFFF" android:textColorHint="#8F879F"
                android:background="@drawable/bg_input" android:padding="13dp"
                android:textSize="14sp" android:layout_marginTop="8dp" />
            <Button android:id="@+id/sendContactMessageButton" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="12dp"
                android:text="ادامه و انتخاب بله برای ارسال" android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary" android:backgroundTint="@null"
                android:elevation="0dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="برای حفظ امنیت، ارسال نهایی داخل بله انجام می‌شود. انتخاب مخاطب در این صفحه به معنی ارسال خودکار برای او نیست."
                android:textColor="#A69DBB" android:textSize="11sp" android:lineSpacingExtra="2dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="17dp" android:background="@drawable/bg_card"
            android:layout_marginTop="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="گوشهٔ موسیقی" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="برای شنیدن نت‌ها، کلیدها را لمس کن" android:textColor="#A69DBB" android:textSize="12sp"
                android:layout_marginTop="3dp" android:layout_marginBottom="13dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="128dp"
                android:orientation="horizontal" android:gravity="center" android:layoutDirection="ltr">
                <Button android:id="@+id/key1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:text="" android:contentDescription="نت یک" android:background="@drawable/bg_piano_key" android:backgroundTint="@null" android:minWidth="0dp" android:padding="0dp" />
                <Button android:id="@+id/key2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:text="" android:contentDescription="نت دو" android:background="@drawable/bg_piano_key" android:backgroundTint="@null" android:minWidth="0dp" android:padding="0dp" />
                <Button android:id="@+id/key3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:text="" android:contentDescription="نت سه" android:background="@drawable/bg_piano_key" android:backgroundTint="@null" android:minWidth="0dp" android:padding="0dp" />
                <Button android:id="@+id/key4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:text="" android:contentDescription="نت چهار" android:background="@drawable/bg_piano_key" android:backgroundTint="@null" android:minWidth="0dp" android:padding="0dp" />
                <Button android:id="@+id/key5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:text="" android:contentDescription="نت پنج" android:background="@drawable/bg_piano_key" android:backgroundTint="@null" android:minWidth="0dp" android:padding="0dp" />
                <Button android:id="@+id/key6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:text="" android:contentDescription="نت شش" android:background="@drawable/bg_piano_key" android:backgroundTint="@null" android:minWidth="0dp" android:padding="0dp" />
                <Button android:id="@+id/key7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:text="" android:contentDescription="نت هفت" android:background="@drawable/bg_piano_key" android:backgroundTint="@null" android:minWidth="0dp" android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Piano SMS • طراحی شده برای اندروید"
            android:textColor="#766D8D" android:textSize="11sp" android:gravity="center"
            android:layout_marginTop="22dp" />
    </LinearLayout>
</ScrollView>
